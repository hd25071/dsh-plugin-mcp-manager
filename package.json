{
  "name": "dsh-plugin-mcp-manager",
  "version": "0.5.3",
  "description": "MCP server manager and marketplace for DeepSeek Harness: browse the official MCP registry, install a server as a profile row with one click, then read, edit, enable or disable every MCP row from the Plugins page.",
  "type": "module",
  "license": "MIT",
  "author": "hd25071",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "mcp-marketplace",
    "plugin-manager"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hd25071/dsh-plugin-mcp-manager.git"
  },
  "homepage": "https://github.com/hd25071/dsh-plugin-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/hd25071/dsh-plugin-mcp-manager/issues"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "market.js",
    "mcpb.js",
    "local.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check market.js && node --check client.js && node --test test/**/*.test.mjs",
    "test": "node --test test/**/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
